<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A single dark theme, on purpose. The page is a dark-first design and its run screen
      is always a dark scoreboard; a timer that flips to a light chrome mid-set would be
      worse, not better. The HTML still follows prefers-color-scheme when opened in a
      normal browser.
    -->
    <style name="Theme.CircuitClock" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
