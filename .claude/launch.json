{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "circuit-clock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/workout-timer.html';const fp=p.join(process.cwd(),u);f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);s.end('not found');return}s.writeHead(200,{'Content-Type':u.endsWith('.html')?'text/html; charset=utf-8':'text/plain'});s.end(d)})}).listen(4173,()=>console.log('serving on http://localhost:4173'))"
      ],
      "port": 4173
    }
  ]
}
